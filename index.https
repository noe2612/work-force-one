<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>WORK FORCE ONE</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #0d1118;
    color: white;
}

header {
    background: linear-gradient(180deg, #1d2531, #11161e);
    text-align: center;
    padding: 25px 15px;
    border-bottom: 4px solid #d4af37;
}

header h1 {
    margin: 0;
    color: #d4af37;
    font-size: 30px;
    letter-spacing: 3px;
}

header p {
    margin: 8px 0 0;
    color: #ddd;
}

.container {
    width: 95%;
    max-width: 850px;
    margin: auto;
    padding: 20px 0;
}

.card {
    background: #1a212c;
    border: 1px solid #303947;
    border-radius: 20px;
    padding: 22px;
    margin-bottom: 20px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.35);
}

h2 {
    margin-top: 0;
    color: #d4af37;
}

/* =========================
   CONTROLE D'ACCÈS
========================= */

.control {
    text-align: center;
}

.code-input {
    width: 100%;
    height: 85px;
    font-size: 30px;
    text-align: center;
    letter-spacing: 3px;
    border-radius: 15px;
    border: 3px solid #d4af37;
    background: #090d13;
    color: white;
    outline: none;
    margin: 15px 0;
}

.code-input:focus {
    box-shadow: 0 0 15px rgba(212,175,55,0.5);
}

.verify {
    width: 100%;
    min-height: 70px;
    font-size: 25px;
    font-weight: bold;
    border: none;
    border-radius: 15px;
    background: #d4af37;
    color: #111;
    cursor: pointer;
}

.verify:active {
    transform: scale(0.98);
}

/* =========================
   RESULTAT
========================= */

#result {
    display: none;
    margin-top: 20px;
    border-radius: 20px;
    padding: 35px 15px;
    text-align: center;
    font-weight: bold;
}

#result .big {
    font-size: 46px;
    line-height: 1.1;
}

#result .name {
    font-size: 30px;
    margin-top: 15px;
}

#result .details {
    font-size: 20px;
    margin-top: 12px;
}

.accepted {
    display: block !important;
    background: #0b6b35;
    border: 5px solid #36e07c;
}

.refused {
    display: block !important;
    background: #8c1111;
    border: 5px solid #ff4545;
}

/* =========================
   FORMULAIRE
========================= */

input[type="text"] {
    width: 100%;
    padding: 15px;
    border-radius: 10px;
    border: 1px solid #555;
    background: #0d1118;
    color: white;
    font-size: 18px;
    margin: 8px 0 15px;
}

.checkbox {
    font-size: 17px;
    display: block;
    margin: 12px 0;
}

.add {
    background: #d4af37;
    color: #111;
    border: none;
    padding: 14px 22px;
    border-radius: 12px;
    font-weight: bold;
    font-size: 17px;
}

/* =========================
   PERSONNES
========================= */

.person {
    padding: 15px 5px;
    border-bottom: 1px solid #3b4350;
}

.person:last-child {
    border-bottom: none;
}

.person-name {
    font-size: 20px;
    font-weight: bold;
}

.person-code {
    color: #d4af37;
    font-family: monospace;
    font-size: 16px;
    margin-top: 5px;
}

.small {
    color: #b8bec7;
}

/* =========================
   TABLE
========================= */

.table-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: 12px 8px;
    border-bottom: 1px solid #3a424f;
    text-align: left;
}

th {
    color: #d4af37;
}

.clear {
    background: #3b4350;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px 15px;
    font-weight: bold;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 500px) {

    header h1 {
        font-size: 25px;
    }

    .code-input {
        font-size: 24px;
        height: 75px;
    }

    .verify {
        font-size: 22px;
    }

    #result .big {
        font-size: 36px;
    }

}

</style>
</head>


<body>

<header>

    <h1>👑 WORK FORCE ONE</h1>

    <p>
        Poste présidentiel de contrôle d'accès
    </p>

</header>


<div class="container">


<!-- =========================
     CONTROLE
========================= -->

<div class="card control">

    <h2>🔐 CONTRÔLE D'ACCÈS</h2>

    <p class="small">
        Entrez le code inscrit sur le ticket de la personne.
    </p>

    <input
        id="codeInput"
        class="code-input"
        type="text"
        placeholder="CODE DU TICKET"
        autocomplete="off"
        autocapitalize="characters"
        onkeydown="if(event.key==='Enter') verifyCode()"
    >

    <button
        class="verify"
        onclick="verifyCode()"
    >
        VÉRIFIER L'ACCÈS
    </button>

    <div id="result">

        <div id="resultBig" class="big"></div>

        <div id="resultName" class="name"></div>

        <div id="resultDetails" class="details"></div>

    </div>

</div>


<!-- =========================
     AJOUT PERSONNE
========================= -->

<div class="card">

    <h2>👤 Ajouter une personne</h2>

    <input
        id="name"
        type="text"
        placeholder="Prénom"
    >

    <label class="checkbox">

        <input
            id="authorized"
            type="checkbox"
            checked
        >

        Autorisation d'entrée

    </label>


    <label class="checkbox">

        <input
            id="privilege"
            type="checkbox"
        >

        ⭐ Passe privilège

    </label>


    <button
        class="add"
        onclick="addPerson()"
    >

        Ajouter la personne

    </button>

</div>


<!-- =========================
     REGISTRE
========================= -->

<div class="card">

    <h2>📋 Registre des entrées</h2>

    <button
        class="clear"
        onclick="clearLog()"
    >

        Effacer le registre

    </button>


    <div class="table-container">

        <table>

            <thead>

                <tr>

                    <th>Personne</th>

                    <th>Date</th>

                    <th>Heure</th>

                    <th>Résultat</th>

                </tr>

            </thead>


            <tbody id="log"></tbody>

        </table>

    </div>

</div>


<!-- =========================
     PERSONNES
========================= -->

<div class="card">

    <h2>👥 Personnes enregistrées</h2>

    <div id="people"></div>

</div>


</div>


<script>

/* ======================================
   STOCKAGE
====================================== */

const PEOPLE_KEY = "WFO_PEOPLE";
const LOG_KEY = "WFO_LOG";


let people =
    JSON.parse(
        localStorage.getItem(PEOPLE_KEY) || "[]"
    );


let log =
    JSON.parse(
        localStorage.getItem(LOG_KEY) || "[]"
    );


/* ======================================
   SAUVEGARDE
====================================== */

function save() {

    localStorage.setItem(
        PEOPLE_KEY,
        JSON.stringify(people)
    );

    localStorage.setItem(
        LOG_KEY,
        JSON.stringify(log)
    );

}


/* ======================================
   SON
====================================== */

function playSound(type) {

    const AudioContext =
        window.AudioContext ||
        window.webkitAudioContext;

    if (!AudioContext) return;


    const audio =
        new AudioContext();


    if (type === "accepted") {

        const osc1 =
            audio.createOscillator();

        const osc2 =
            audio.createOscillator();

        const gain =
            audio.createGain();


        osc1.frequency.value = 700;
        osc2.frequency.value = 1000;


        osc1.type = "sine";
        osc2.type = "sine";


        osc1.connect(gain);
        osc2.connect(gain);

        gain.connect(audio.destination);


        gain.gain.setValueAtTime(
            0.45,
            audio.currentTime
        );

        gain.gain.exponentialRampToValueAtTime(
            0.01,
            audio.currentTime + 0.8
        );


        osc1.start();

        osc2.start(
            audio.currentTime + 0.12
        );


        osc1.stop(
            audio.currentTime + 0.8
        );

        osc2.stop(
            audio.currentTime + 0.8
        );


    } else {

        const osc =
            audio.createOscillator();

        const gain =
            audio.createGain();


        osc.type = "square";

        osc.frequency.value = 180;


        osc.connect(gain);

        gain.connect(audio.destination);


        gain.gain.setValueAtTime(
            0.55,
            audio.currentTime
        );


        gain.gain.exponentialRampToValueAtTime(
            0.01,
            audio.currentTime + 1
        );


        osc.start();


        osc.stop(
            audio.currentTime + 1
        );

    }

}


/* ======================================
   AJOUT PERSONNE
====================================== */

function addPerson() {

    const name =
        document
        .getElementById("name")
        .value
        .trim();


    if (!name) {

        alert(
            "Veuillez entrer un prénom."
        );

        return;

    }


    const code =
        "WFO-" +
        Math.random()
        .toString(36)
        .substring(2, 10)
        .toUpperCase();


    people.push({

        name: name,

        code: code,

        authorized:
            document
            .getElementById("authorized")
            .checked,

        privilege:
            document
            .getElementById("privilege")
            .checked

    });


    save();

    render();


    document
        .getElementById("name")
        .value = "";


    alert(
        "PERSONNE AJOUTÉE\n\n" +
        "Prénom : " + name +
        "\n\n" +
        "Code du ticket :\n" +
        code
    );

}


/* ======================================
   VERIFICATION
====================================== */

function verifyCode() {

    const input =
        document
        .getElementById("codeInput");


    const code =
        input.value
        .trim()
        .toUpperCase();


    if (!code) {

        return;

    }


    const person =
        people.find(
            p =>
                p.code.toUpperCase() === code
        );


    const now =
        new Date();


    const date =
        now.toLocaleDateString("fr-FR");


    const time =
        now.toLocaleTimeString("fr-FR");


    const result =
        document.getElementById("result");


    const big =
        document.getElementById("resultBig");


    const name =
        document.getElementById("resultName");


    const details =
        document.getElementById("resultDetails");


    result.className = "";


    /* =========================
       AUTORISÉ
    ========================= */

    if (
        person &&
        person.authorized
    ) {

        result.className =
            "accepted";


        big.innerHTML =
            "✅<br>ACCÈS AUTORISÉ";


        name.innerHTML =
            person.name;


        details.innerHTML =
            person.privilege
            ? "⭐ PASSE PRIVILÈGE"
            : "Autorisation valide";


        log.push({

            name: person.name,

            date: date,

            time: time,

            ok: true

        });


        playSound("accepted");


    }

    /* =========================
       REFUSÉ
    ========================= */

    else {

        result.className =
            "refused";


        big.innerHTML =
            "❌<br>ACCÈS REFUSÉ";


        if (person) {

            name.innerHTML =
                person.name;

            details.innerHTML =
                "Cette personne n'est pas autorisée.";

        } else {

            name.innerHTML =
                "CODE INCONNU";

            details.innerHTML =
                "Aucune personne enregistrée avec ce code.";

        }


        log.push({

            name:
                person
                ? person.name
                : "Inconnu",

            date: date,

            time: time,

            ok: false

        });


        playSound("refused");

    }


    save();

    render();


    input.value = "";

    input.focus();

}


/* ======================================
   AFFICHAGE DES PERSONNES
====================================== */

function render() {


    const peopleContainer =
        document.getElementById("people");


    if (people.length === 0) {

        peopleContainer.innerHTML =
            "<p class='small'>" +
            "Aucune personne enregistrée." +
            "</p>";

    } else {

        peopleContainer.innerHTML =

            people.map(
                p => `

                <div class="person">

                    <div class="person-name">
                        ${escapeHtml(p.name)}
                    </div>

                    <div class="person-code">
                        ${p.code}
                    </div>

                    <div class="small">

                        ${
                            p.authorized
                            ? "✅ Autorisé"
                            : "❌ Non autorisé"
                        }

                        ${
                            p.privilege
                            ? " · ⭐ Passe privilège"
                            : ""
                        }

                    </div>

                </div>

                `
            ).join("");

    }


    /* =========================
       REGISTRE
    ========================= */

    const logContainer =
        document.getElementById("log");


    logContainer.innerHTML =

        log
        .slice()
        .reverse()
        .map(
            x => `

            <tr>

                <td>
                    ${escapeHtml(x.name)}
                </td>

                <td>
                    ${x.date}
                </td>

                <td>
                    ${x.time}
                </td>

                <td>
                    ${
                        x.ok
                        ? "✅ Autorisé"
                        : "❌ Refusé"
                    }
                </td>

            </tr>

            `
        )
        .join("");

}


/* ======================================
   SECURITE AFFICHAGE
====================================== */

function escapeHtml(text) {

    return String(text)
        .replace(
            /[&<>"']/g,
            function(match) {

                return {

                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#039;"

                }[match];

            }
        );

}


/* ======================================
   EFFACER REGISTRE
====================================== */

function clearLog() {

    if (
        confirm(
            "Effacer tout le registre des entrées ?"
        )
    ) {

        log = [];

        save();

        render();

    }

}


/* ======================================
   INITIALISATION
====================================== */

render();


document
    .getElementById("codeInput")
    .focus();

</script>

</body>
</html>
